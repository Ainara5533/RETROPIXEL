import random

# --- CONSTANTES Y CONFIGURACIÓN ---
CATEGORIAS = ["Acción", "Aventura", "Deportes", "Estrategia", "Terror", "Ciencia Ficción", "Infantil", "Otro"]
ESTADOS = ["Disponible", "Alquilado", "Reservado", "Discontinuado"]
TIPOS = ["Película", "Videojuego"]

def mostrar_menu():
    """Muestra las opciones principales del sistema [5]."""
    print("\n" + "="*50)
    print("SISTEMA DE GESTIÓN: RETROPIXEL STORE")
    print("1. Registrar producto (Alta)")
    print("2. Eliminar producto (Baja)")
    print("3. Modificar producto (Modificación)")
    print("4. Informe General – Visualización ordenada")
    print("5. Reporte Estadístico (Matriz de Stock)")
    print("6. Salir")
    print("="*50)

# --- FUNCIONES DE VALIDACIÓN ---
def validar_no_vacio(mensaje):
    """Asegura que el string ingresado no esté vacío [6]."""
    valor = input(mensaje)
    while valor == "":
        print("Error: El campo no puede quedar vacío.")
        valor = input(mensaje)
    return valor

def validar_positivo(mensaje, es_decimal=False):
    """Valida que los números sean positivos o cero [6-8]."""
    continuar = True
    while continuar:
        try:
            num_str = input(mensaje)
            num = float(num_str) if es_decimal else int(num_str)
            if num >= 0:
                continuar = False
            else:
                print("Error: Debe ser un número positivo.")
        except ValueError:
            print("Error: Ingrese un valor numérico válido.")
    return num

# --- LÓGICA DE NEGOCIO ---
def registrar_producto(titulos, tipos, formatos, precios, stocks, cats, estados):
    """Carga un nuevo producto manualmente o aleatorio [5]."""
    modo = input("¿Carga manual (M) o aleatoria para pruebas (A)?: ").upper()
    
    if modo == 'A':
        titulo = "Juego_" + str(random.randint(100, 999))
        tipo = random.choice(TIPOS)
        formato = "Digital"
        precio = round(random.uniform(1000, 50000), 2)
        stock = random.randint(0, 50)
        cat = random.choice(CATEGORIAS)
        est = random.choice(ESTADOS)
    else:
        titulo = validar_no_vacio("Título del producto: ")
        tipo = TIPOS[validar_positivo("Tipo (0: Película, 1: Videojuego): ")] # Simplificado para el ejemplo
        formato = validar_no_vacio("Plataforma/Formato: ")
        precio = validar_positivo("Precio: ", True)
        stock = validar_positivo("Cantidad en stock: ")
        cat = random.choice(CATEGORIAS) # En un sistema real se elegiría de la lista
        est = ESTADOS

    titulos.append(titulo)
    tipos.append(tipo)
    formatos.append(formato)
    precios.append(precio)
    stocks.append(stock)
    cats.append(cat)
    estados.append(est)
    print(f"Producto '{titulo}' registrado con éxito.")

def ordenar_datos(titulos, stocks):
    """Ordena manualmente de mayor a menor por stock y alfabético por título [9, 10]."""
    n = len(titulos)
    for i in range(n - 1):
        for j in range(n - 1 - i):
            # Criterio 1: Stock descendente. Criterio 2: Título ascendente si hay empate [9].
            if (stocks[j] < stocks[j+1]) or (stocks[j] == stocks[j+1] and titulos[j] > titulos[j+1]):
                # Intercambio manual en todas las listas paralelas (se omiten las demás por brevedad)
                stocks[j], stocks[j+1] = stocks[j+1], stocks[j]
                titulos[j], titulos[j+1] = titulos[j+1], titulos[j]

def generar_matriz_stock(cats, stocks):
    """Crea una matriz para analizar stock por categoría [4]."""
    # Matriz inicializada en cero: Filas = Categorías, Columna 0 = Cantidad Total
    matriz = []
    for i in range(len(CATEGORIAS)):
        matriz.append([CATEGORIAS[i], 0])
    
    # Procesamiento: Recorrer listas y acumular en matriz [4]
    for i in range(len(stocks)):
        for f in range(len(matriz)):
            if cats[i] == matriz[f]:
                matriz[f][11] += stocks[i]
    
    print("\n--- REPORTE MATRICIAL: STOCK POR CATEGORÍA ---")
    for fila in matriz:
        print(f"{fila:<20} | Unidades: {fila[11]}")

# --- FLUJO PRINCIPAL ---
def main():
    # Listas paralelas para gestionar datos en RAM [3]
    titulos, tipos_cont, formatos, precios, stocks, categorias, estados_disp = [], [], [], [], [], [], []
    
    esta_corriendo = True
    while esta_corriendo:
        mostrar_menu()
        opcion = input("Seleccione una opción: ")
        
        if opcion == '1':
            registrar_producto(titulos, tipos_cont, formatos, precios, stocks, categorias, estados_disp)
        elif opcion == '4':
            ordenar_datos(titulos, stocks)
            print("\nListado Ordenado:")
            for i in range(len(titulos)):
                print(f"{titulos[i]} - Stock: {stocks[i]}")
        elif opcion == '5':
            generar_matriz_stock(categorias, stocks)
        elif opcion == '6':
            print("Saliendo del sistema...")
            esta_corriendo = False
        else:
            print("Opción no válida o funcionalidad pendiente [12].")

if __name__ == "__main__":
    main()
